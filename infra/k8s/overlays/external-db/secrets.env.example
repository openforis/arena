# Copy to secrets.env and fill in. Never commit secrets.env.

# Random strings, 64+ characters each (e.g. "openssl rand -hex 32")
USER_AUTH_TOKEN_SECRET=
USER_2FA_SECRET=

# Password of the system administrator created at the first startup: remove it afterwards
ADMIN_PASSWORD=

# Email service credentials: Arena does not start without them
SENDGRID_API_KEY=
# EMAIL_AUTH_USER=
# EMAIL_AUTH_PASSWORD=
# EMAIL_AMAZON_SES_HOST=

# Optional: S3 file storage (required to run more than one replica)
# FILE_STORAGE_AWS_S3_BUCKET_NAME=
# FILE_STORAGE_AWS_S3_BUCKET_REGION=
# FILE_STORAGE_AWS_ACCESS_KEY=
# FILE_STORAGE_AWS_SECRET_ACCESS_KEY=
