# Non-secret Arena settings (see .env.template in the repository root for the full list).

# Database
PGHOST=db.example.org
PGPORT=5432
PGSSL=true
# Set to true to accept a server certificate that cannot be verified
PGSSL_ALLOW_UNAUTHORIZED=false

# System administrator: created at the first startup, also the default email sender
ADMIN_EMAIL=admin@example.org

# Email: sendgrid / office365 / amazonSES (the matching credentials go in secrets.env)
EMAIL_SERVICE=sendgrid

# Public origin used in emails and QR codes
ARENA_PUBLIC_URL=https://arena.example.org

# AI features (all optional; see .env.template for the full list)
# AI_FEATURES_ENABLED=false
# Per-feature flags, can only disable: {"translation":false,"dataDictionary":false}
# AI_FEATURE_FLAGS=
# AI_DEFAULT_PROVIDER=
# AI_DEFAULT_MODEL=
# AI_DEFAULT_BASE_URL=
# Max output tokens per call (default 4096) and calls per user per minute (default 30, 0 = no limit)
# AI_MAX_OUTPUT_TOKENS=4096
# AI_RATE_LIMIT_PER_MINUTE=30
# Base URLs users may point their own provider to even when they resolve to private addresses
# (comma-separated, e.g. an Ollama server on the internal network)
# AI_ORG_HOSTED_BASE_URLS=
# Survey AI policy ceilings (off | onDevice | orgHosted | cloud; default cloud)
# AI_POLICY_MAX_SCHEMA=cloud
# AI_POLICY_MAX_DATA=cloud
