# Non-secret Arena settings (see .env.template in the repository root for the full list).

# Database
PGHOST=db.example.org
PGPORT=5432
PGSSL=true
# Set to true to accept a server certificate that cannot be verified
PGSSL_ALLOW_UNAUTHORIZED=false

# System administrator: created at the first startup, also the default email sender
ADMIN_EMAIL=admin@example.org

# Email: sendgrid / office365 / amazonSES (the matching credentials go in secrets.env)
EMAIL_SERVICE=sendgrid

# Public origin used in emails and QR codes
ARENA_PUBLIC_URL=https://arena.example.org
